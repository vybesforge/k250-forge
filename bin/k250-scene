#!/usr/bin/env bash
# k250-scene — run a K250-4S pattern on the e-stim box.
#
# Usage:
#   k250-scene <pattern> [--base N] [--peak N] [--secs N] [--hardcap N]
#                         [--ma-top N] [--sweep-period N] [--limits FILE]
#   k250-scene --list
#   k250-scene --limits-show
#
# SAFETY: the power ceiling comes from limits.json (power.max_percent). A
# --hardcap on the command line can only LOWER it, never raise it. This is
# enforced in code so a driver -- human or AI -- cannot exceed the agreed limit
# by typo, by drift, or by persuasion.
#
# One BLE connection at a time: never run two of these at once.
set -euo pipefail

PY=${K250_PY:-"${K250_DIR:-$HOME/k250-forge}/venv/bin/python"}
PLAY="${K250_DIR:-$HOME/k250-forge}/k250_play.py"
DEFAULT_LIMITS="${K250_LIMITS:-${K250_DIR:-$HOME/k250-forge}/limits.json}"

# resolve our own location so a clone works from anywhere (bin/ -> repo root)
# Resolve this script's real path. `readlink -f` is GNU-only -- macOS and Git Bash
# don't have it, so fall back to a portable symlink walk (readlink alone is POSIX).
SELF="${BASH_SOURCE[0]}"
if readlink -f "$SELF" >/dev/null 2>&1; then
  SELF="$(readlink -f "$SELF")"
else
  while [ -L "$SELF" ]; do
    _t="$(readlink "$SELF")"
    case "$_t" in /*) SELF="$_t" ;; *) SELF="$(dirname "$SELF")/$_t" ;; esac
  done
  SELF="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P)/$(basename "$SELF")"
fi
HERE="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd || echo "$HOME/k250-forge")"
if [ -z "${K250_DIR:-}" ] && [ -f "$HERE/k250_play.py" ]; then
  PY="${K250_PY:-$HERE/venv/bin/python}"
  PLAY="$HERE/k250_play.py"
  DEFAULT_LIMITS="${K250_LIMITS:-$HERE/limits.local.json}"
  [ -f "$DEFAULT_LIMITS" ] || DEFAULT_LIMITS="${K250_LIMITS:-$HERE/limits.json}"
fi
DIR="${K250_DIR:-$HERE}"          # where the modules, the ledger and the helper live

# Bail out LOUDLY if the modules are not there. A silent fallback (`|| echo
# "$HOME/k250-forge"` above) sends you to a directory that is not your clone and
# then reports that path back as if it were the truth -- which is how a wrapper
# ends up printing a lowercase path for an uppercase clone, or a path that does
# not exist at all.
if [ ! -f "$DIR/k250_play.py" ]; then
  echo "k250: cannot find k250_play.py." >&2
  echo "      looked in: $DIR" >&2
  echo "      Set K250_DIR to your working directory, or run ./install.sh from your clone." >&2
  exit 1
fi

# python, with a clear message instead of bash's 'No such file or directory'.
# This has to happen BEFORE any argument handling: `--list` and `--limits-show`
# need an interpreter too, and a missing venv used to surface as a raw exec error.
[ -x "$PY" ] || {
  if command -v python3 >/dev/null && python3 -c "import bleak" 2>/dev/null; then
    echo "note: no venv here, using system python3 (bleak found)" >&2
    PY="$(command -v python3)"
  else
    echo "k250: no venv and no bleak available — run ./install.sh first." >&2
    exit 1
  fi
}

if [ $# -eq 0 ]; then
  exec "$PY" "$PLAY" --help
fi

if [ "$1" = "--list" ]; then
  # The engine owns the pattern list (so Windows, which has no wrapper, can ask it too).
  # `python -` puts the CALLER's cwd on sys.path[0], not this script's directory, hence the exec
  # of the real file rather than a heredoc import.
  exec "$PY" "$PLAY" --list
fi

# find --limits FILE anywhere in the args (so limits can be swapped per scene)
LIMITS="$DEFAULT_LIMITS"
args=("$@")
for i in "${!args[@]}"; do
  if [ "${args[$i]}" = "--limits" ]; then
    LIMITS="${args[$((i+1))]}"
  fi
done

READ=$("$PY" - "$LIMITS" <<'EOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print("could not read limits file: %s" % e, file=sys.stderr)
    sys.exit(1)
p  = d.get("power", {})
fq = d.get("frequency", d.get("speed", {}))        # 'speed' = older name for MA
sl = d.get("slew", d.get("movement", {}))          # 'movement' = older name for slew
fmax = fq.get("max", 2500)
smax = sl.get("max_percent_per_second", sl.get("percent_per_second", 0))
pc = (d.get("channels") or {}).get("per_channel") or {}
pc = {k: {kk: vv for kk, vv in (v or {}).items() if vv is not None}
      for k, v in pc.items()}
pc = {k: v for k, v in pc.items() if v}
print("|".join([str(p.get("max_percent", 50)), str(p.get("default_percent", 5)),
                str(d.get("stop_word", "red")), str(smax), str(fmax),
                json.dumps(pc),
                str((d.get("session") or {}).get("max_duration_s", 1800))]))
EOF
)
CAP=$(echo "$READ" | cut -d'|' -f1)
DEF=$(echo "$READ" | cut -d'|' -f2)
STOP=$(echo "$READ" | cut -d'|' -f3)
RATE=$(echo "$READ" | cut -d'|' -f4)
FMAX=$(echo "$READ" | cut -d'|' -f5)
PCAPS=$(echo "$READ" | cut -d'|' -f6-6)
SESS=$(echo "$READ" | cut -d'|' -f7)

if [ "$1" = "--limits-show" ]; then
  echo "limits file : $LIMITS"
  echo "POWER ceiling : ${CAP}%   (engine will not write above this)"
  echo "POWER start   : ${DEF}%"
  echo "FREQUENCY max : ${FMAX}   (MA / Multi Adjust -- character, not level)"
  echo "SLEW max      : ${RATE}%/second  (how fast power may move; 0 = unlimited)"
  echo "stop word     : $STOP"
  echo "per-channel   : ${PCAPS:- (none -- all channels use the global limits)}"
  "$PY" "$DIR/k250_session.py" show --max "$SESS" --dir "$DIR" 2>/dev/null \
    | sed 's/^session/session       /' || true
  exit 0
fi

# strip --limits / --reset-session from what we forward (the engine knows neither)
FWD=()
RESET=0
skip=0
for i in "${!args[@]}"; do
  if [ "$skip" = "1" ]; then skip=0; continue; fi
  case "${args[$i]}" in
    --limits) skip=1; continue ;;
    --reset-session) RESET=1; continue ;;
  esac
  FWD+=("${args[$i]}")
done

# effective cap = min(caller hardcap if any, limits cap)
HARD=""
for i in "${!FWD[@]}"; do
  if [ "${FWD[$i]}" = "--hardcap" ]; then HARD="${FWD[$((i+1))]}"; fi
done

if [ -z "$HARD" ]; then
  EFF="$CAP"
else
  EFF=$("$PY" -c "print(min(float('$HARD'), float('$CAP')))")
  if "$PY" -c "import sys; sys.exit(0 if float('$HARD') > float('$CAP') else 1)"; then
    echo "NOTE: --hardcap $HARD exceeds the agreed cap ${CAP}% — clamped to ${CAP}%." >&2
  fi
fi
EFF=$(printf '%.0f' "$EFF")

# FREQUENCY: the limits file caps it too (MA / Multi Adjust -- the character)
MA_TOP=""
for i in "${!FWD[@]}"; do
  case "${FWD[$i]}" in
    --frequency|--ma-top) MA_TOP="${FWD[$((i+1))]}" ;;
  esac
done
if [ -z "$MA_TOP" ]; then
  EFF_FREQ="$FMAX"
else
  EFF_FREQ=$("$PY" -c "print(min(float('$MA_TOP'), float('$FMAX')))")
fi
EFF_FREQ=$(printf '%.0f' "$EFF_FREQ")

# SLEW: a caller may ask for a gentler power movement, never a harsher one
SLW=""
for i in "${!FWD[@]}"; do
  case "${FWD[$i]}" in
    --slew|--speed|--max-rate) SLW="${FWD[$((i+1))]}" ;;
  esac
done
if [ -z "$SLW" ]; then
  EFF_SLEW="$RATE"
elif [ "$RATE" = "0" ]; then
  EFF_SLEW="$SLW"
else
  EFF_SLEW=$("$PY" -c "print(min(float('$SLW'), float('$RATE')))")
fi
EFF_SLEW=$(printf '%.0f' "$EFF_SLEW")

EXTRA=()
if [ -n "$PCAPS" ] && [ "$PCAPS" != "{}" ]; then
  EXTRA+=(--channel-caps "$PCAPS")
fi

echo "limits: $(basename "$LIMITS")  POWER<${EFF}%  FREQUENCY<${EFF_FREQ}  SLEW=${EFF_SLEW}%/s  stop=${STOP}" >&2
if [ ${#EXTRA[@]} -gt 0 ]; then echo "        per-channel: ${PCAPS}" >&2; fi
# (the interpreter was checked and, if needed, downgraded to system python3 right
# after DIR was resolved -- before any of the python calls below)
SESS_FILE="$DIR/k250_session.py"
if [ "$RESET" = "1" ] && [ -f "$SESS_FILE" ]; then
  "$PY" "$SESS_FILE" reset --dir "$DIR"
fi

# Session budget: enforced, not advisory. K250_IGNORE_SESSION=1 is the
# deliberate override (it should be a decision, not an accident).
if [ -f "$SESS_FILE" ] && [ "${K250_IGNORE_SESSION:-0}" != "1" ]; then
  if ! "$PY" "$SESS_FILE" check --max "$SESS" --dir "$DIR"; then
    exit 1
  fi
fi

START=$(date +%s)
# K250_WRAPPED=1: the wrapper has already read the limits file and charged the
# session ledger, so the engine must not do either again on its own.
#
# ${A[@]+"${A[@]}"} -- NOT plain "${A[@]}". Under `set -u`, bash before 4.4 treats an
# empty array expansion as an unbound variable, so `"${EXTRA[@]}"` (always empty
# unless per-channel caps are set) killed this line on macOS's stock bash 3.2:
# the primary tool could not run at all. FWD is non-empty in normal use but empty
# for e.g. `k250-scene --limits foo`, so it gets the same guard.
K250_WRAPPED=1 "$PY" "$PLAY" ${FWD[@]+"${FWD[@]}"} --hardcap "$EFF" --slew "$EFF_SLEW" --frequency "$EFF_FREQ" ${EXTRA[@]+"${EXTRA[@]}"}
RC=$?
END=$(date +%s)

if [ -f "$SESS_FILE" ]; then
  "$PY" "$SESS_FILE" add --seconds "$((END - START))" --max "$SESS" --dir "$DIR" || true
fi
exit $RC
