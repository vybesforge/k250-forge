#!/usr/bin/env bash
# k250-stop — INSTANT STOP for the K250-4S e-stim box.
#
# Kills any running pattern, then writes PW=0 to every plugged channel.
# Run this immediately on the stop word, on any sign of distress, or if a
# pattern is misbehaving. Safe to run repeatedly.
#
# Exit 0 = stopped. Exit 1 = COULD NOT REACH THE BOX — treat as unsafe: the box
# may still be energised. Get to it physically (hold any knob 2 s = power off).
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd || echo "${K250_DIR:-$HOME/k250}")"
DIR="${K250_DIR:-$HERE}"
[ -x "$DIR/venv/bin/python" ] 2>/dev/null || true
if [ ! -x "${K250_PY:-${DIR:-$HOME/k250}/venv/bin/python}" ]; then
  echo "note: no venv found — run ./install.sh, or set K250_PY" >&2
  PY="$(command -v python3)"
else
  PY="${K250_PY:-${DIR:-$HOME/k250}/venv/bin/python}"
fi
exec "$PY" "${K250_DIR:-${DIR:-$HOME/k250}}/k250_stop.py"
