#!/usr/bin/env bash
# k250-stop — INSTANT STOP for the K250-4S e-stim box.
#
# Kills any running pattern, then writes PW=0 to every plugged channel.
# Run this immediately on the stop word, on any sign of distress, or if a
# pattern is misbehaving. Safe to run repeatedly.
#
# Exit 0 = stopped. Exit 1 = COULD NOT REACH THE BOX — treat as unsafe: the box
# may still be energised. Get to it physically (hold any knob 2 s = power off).
# Resolve this script's real path. `readlink -f` is GNU-only -- macOS and Git Bash
# don't have it, so fall back to a portable symlink walk (readlink alone is POSIX).
SELF="${BASH_SOURCE[0]}"
if readlink -f "$SELF" >/dev/null 2>&1; then
  SELF="$(readlink -f "$SELF")"
else
  while [ -L "$SELF" ]; do
    _t="$(readlink "$SELF")"
    case "$_t" in /*) SELF="$_t" ;; *) SELF="$(dirname "$SELF")/$_t" ;; esac
  done
  SELF="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P)/$(basename "$SELF")"
fi
HERE="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd || echo "${K250_DIR:-$HOME/k250-forge}")"
DIR="${K250_DIR:-$HERE}"
PY="${K250_PY:-$DIR/venv/bin/python}"
# Missing modules must be LOUD here, not a raw exec error: this wrapper's exit
# code is the safety signal, and "python: can't open file" is not an answer
# anyone can act on in the moment it is needed.
if [ ! -f "$DIR/k250_stop.py" ]; then
  echo "k250-stop: CANNOT RUN — k250_stop.py not found in $DIR" >&2
  echo "  The box may still be energised. Get to it physically:" >&2
  echo "  hold any knob ~2 seconds to power it off." >&2
  exit 1
fi
[ -x "$PY" ] || {
  if command -v python3 >/dev/null && python3 -c "import bleak" 2>/dev/null; then
    echo "note: no venv here, using system python3 (bleak found)" >&2
    PY="$(command -v python3)"
  else
    echo "k250: no venv and no bleak available — run ./install.sh first." >&2
    exit 1
  fi
}
exec "$PY" "$DIR/k250_stop.py"
