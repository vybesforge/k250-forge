#!/usr/bin/env bash
# k250-status — read the K250-4S state: firmware, battery, LIVE CHANNELS,
# pattern and speed per channel. Read-only: it never changes power.
#
# NOTE: PW (power) is NOT reported by the box in a read-all — it is only echoed
# when written. So "power" never appears here even while the box is running.
# The one honest witness that power is flowing is the operator.
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd || echo "${K250_DIR:-$HOME/k250}")"
DIR="${K250_DIR:-$HERE}"
exec "${K250_PY:-$DIR/venv/bin/python}" "$DIR/k250_status.py"