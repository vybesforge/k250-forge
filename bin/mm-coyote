#!/usr/bin/env python3
"""mm-coyote — MM-driven Coyote V3 control over the LAN bridge.

  mm-coyote <stim> <level> <secs>
  mm-coyote stop
Stims (coyote_play.py --list): e.g. "Jouissif/pulse2BSlow", "gifs/24854991a".
Bridge clamps to the wearer's limits.json and never raises a ceiling.
"""
import json, os, sys, urllib.request, urllib.error

HOST = os.environ.get("MM_BRIDGE", "http://127.0.0.1:8791")
TOK = (os.environ.get("MM_BRIDGE_TOKEN") or open(os.path.expanduser("~/.config/mm-vr-bridge/token")).read().strip())

def post(rel, body):
    req = urllib.request.Request(HOST + rel, data=json.dumps(body).encode(),
                                 headers={"Authorization": "Bearer " + TOK, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print(r.status, r.read().decode(errors="replace")[:400])
    except urllib.error.HTTPError as e:
        print("HTTP", e.code, e.read().decode(errors="replace")[:300]); sys.exit(e.code)

def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__); return
    if a[0] == "stop":
        post("/coyote/stop", {}); return
    s, lvl, secs = a[0], float(a[1]), float(a[2])
    post("/coyote/run", {"stim": s, "level": lvl, "secs": secs})

if __name__ == "__main__":
    main()
